APP_NAME="账本管理系统"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9193

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 数据库：默认 SQLite（无需安装，文件在 database/database.sqlite）
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

# 如需改用 MySQL，注释上面两行，启用下面几行
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=liushui
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 会员接口 JWT 签名盐值（部署时请换成自己的随机字符串）
JWT_SECRET=change-me-to-a-random-string

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
